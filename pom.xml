<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>
    <groupId>br.pucrs.pulsepass</groupId>
    <artifactId>pulsepass</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <properties>
        <java.version>21</java.version>
    </properties>
    <modules>
        <module>libs/security-lib</module>
        <module>libs/messaging-lib</module>
        <module>services/api-gateway</module>
        <module>services/iam-admin-service</module>
        <module>services/inventory-service</module>
        <module>services/order-service</module>
        <module>services/ticket-service</module>
        <module>services/analytics-service</module>
        <module>services/realtime-service</module>
    </modules>
    <profiles>
        <profile>
            <id>integration</id>
            <modules><module>integration-tests</module></modules>
        </profile>
    </profiles>
    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution><goals><goal>prepare-agent</goal></goals></execution>
                    <execution>
                        <id>domain-coverage</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal><goal>check</goal></goals>
                        <configuration>
                            <rules><rule>
                                <element>PACKAGE</element>
                                <includes><include>*.domain</include></includes>
                                <limits><limit>
                                    <counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.70</minimum>
                                </limit></limits>
                            </rule></rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
